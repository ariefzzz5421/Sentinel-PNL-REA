# Preferred active NFT market data provider (server-side, required for OpenSea profile + live scans).
OPENSEA_API_KEY=

# Deprecated; do not use for new NFT scans. Leave empty.
# RESERVOIR_API_KEY=

# Public Privy app ID. Create an app and allow your local/production domains in Privy.
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional Ethereum mainnet RPC used server-side for ENS resolution.
# Defaults to a public Ethereum RPC when empty; a dedicated endpoint is more reliable.
ENS_RPC_URL=

# Network metadata for future chain-specific adapters. RPC is not an NFT trade index.
ROBINHOOD_RPC_URL=
ROBINHOOD_ACTIVITY_API_KEY=
ARC_RPC_URL=
ARC_ACTIVITY_API_KEY=

# Optional legacy normalized provider. Used only when RESERVOIR_API_KEY is empty.
SENTINEL_PROVIDER_URL=
SENTINEL_PROVIDER_API_KEY=

# Optional ORD.NET read-only admin wallet integration; /admin/ordnet.
# Set strong unique secrets ONLY on the server. No NEXT_PUBLIC_ prefix.
ORDNET_ADMIN_PASSWORD=
ORDNET_COOKIE_SECRET=
